# An Ethereum mainnet RPC URL — free ones work fine:
# https://eth.llamarpc.com or a free Alchemy/Infura app
PONDER_RPC_URL_1=https://eth.llamarpc.com

# Comma-separated list of wallet addresses to continuously index.
# These are the wallets you track on an ongoing basis (not ad-hoc lookups).
TRACKED_WALLETS=0xYourWalletToTrack,0xAnotherWalletToTrack

# Block to start indexing from — pick something close to when the
# wallet(s) became active to avoid scanning years of empty history.
START_BLOCK=19000000
